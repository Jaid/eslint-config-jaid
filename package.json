{
  "name": "eslint-config-jaid",
  "version": "37.0.0",
  "type": "module",
  "description": "Personal ESLint preset. Intentionally ugly to write code that looks like I feel.",
  "keywords": [
    "ecmascript",
    "eslint",
    "eslint-config",
    "eslint-configs",
    "eslint-preset",
    "eslint-shareable-configs",
    "eslintconfig",
    "format",
    "formatter",
    "formatting",
    "jaid",
    "javascript",
    "jsx",
    "lint",
    "linter",
    "react",
    "style",
    "style-guide"
  ],
  "author": "Jaid <jaid.jsx@gmail.com> (https://github.com/Jaid)",
  "funding": "https://github.com/sponsors/Jaid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaid/eslint-config-jaid.git"
  },
  "scripts": {
    "build": "build_lib",
    "build:development": "NODE_ENV=development bun x rolldown --config",
    "build:production": "NODE_ENV=production bun x rolldown --config",
    "build-page": "fse emptyDir dist/page && bun src/scripts/activeHtml.ts && bun src/scripts/unusedHtml.ts && bun src/scripts/deprecatedHtml.ts && fse copy etc/page dist/page",
    "inspect-config": "bun --bun x @eslint/config-inspector --config src/main.ts",
    "inspect-static": "bun run inspect-config build",
    "print-config": "bun x eslint --print-config src/main.ts",
    "test": "bun test --max-concurrency 1 ./test",
    "tsc": "bun x tsc"
  },
  "dependencies": {
    "browserslist-config-jaid-node": "3.0.0",
    "es-toolkit": "1.52.0",
    "eslint": "10.12.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsonc": "3.4.2",
    "eslint-plugin-n": "18.4.1",
    "eslint-plugin-package-json": "1.10.1",
    "eslint-plugin-perfectionist": "5.12.1",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-unicorn": "78.0.0",
    "eslint-plugin-yml": "3.9.0",
    "eslint-plugin-you-dont-need-lodash-underscore": "6.14.0",
    "eslint-plugin-zod": "5.2.0",
    "forward-slash-path": "0.3.0",
    "jsonc-eslint-parser": "3.3.0",
    "yaml-eslint-parser": "2.1.0",
    "@eslint/markdown": "8.0.3",
    "@eslint-react/eslint-plugin": "5.27.2",
    "@stylistic/eslint-plugin": "6.0.0-beta.6",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2"
  },
  "devDependencies": {
    "chalk": "6.0.1",
    "debug": "4.4.3",
    "filter-obj": "6.1.0",
    "fs-extra": "11.4.1",
    "globby": "16.2.4",
    "handlebars": "4.7.10",
    "immer": "11.1.21",
    "list-dir-content-size": "0.0.5",
    "more-types": "0.6.0",
    "pretty-bytes": "7.2.0",
    "rolldown": "1.2.14",
    "rolldown-plugin-dts": "0.28.8",
    "showdown": "2.1.0",
    "sort-keys": "6.0.1",
    "tsconfig-jaid-bun": "16.0.0",
    "type-fest": "5.10.0",
    "typescript": "npm:typescript-classic@6.0.4",
    "yaml": "2.9.1",
    "@atao60/fse-cli": "0.1.9",
    "@eslint/config-inspector": "3.5.0",
    "@types/bun": "1.4.3",
    "@types/fs-extra": "11.0.4",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0"
  }
}
