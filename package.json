{
  "name": "eslint-config-jaid",
  "version": "26.0.0",
  "type": "module",
  "description": "Personal ESLint preset. Intentionally ugly to write code that looks like I feel.",
  "keywords": [
    "ecmascript",
    "eslint",
    "eslint-config",
    "eslint-configs",
    "eslint-preset",
    "eslint-shareable-configs",
    "eslintconfig",
    "format",
    "formatter",
    "formatting",
    "jaid",
    "javascript",
    "jsx",
    "lint",
    "linter",
    "react",
    "style",
    "style-guide"
  ],
  "author": "Jaid <jaid.jsx@gmail.com> (https://github.com/Jaid)",
  "funding": "https://github.com/sponsors/Jaid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaid/eslint-config-jaid.git"
  },
  "scripts": {
    "build": "bun x rolldown --config",
    "build:production": "NODE_ENV=production bun run build",
    "buildPage": "fse emptyDir dist/page && bun src/scripts/activeHtml.ts && bun src/scripts/unusedHtml.ts && bun src/scripts/deprecatedHtml.ts && fse copy etc/page dist/page",
    "inspectConfig": "bun --bun x @eslint/config-inspector --config src/index.ts",
    "inspectStatic": "bun run inspectConfig build",
    "printConfig": "bun x eslint --print-config src/index.ts",
    "test": "bun test --max-concurrency 1 ./test",
    "tsc": "bun x tsc"
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "browserslist-config-jaid-node": "3.0.0",
    "es-toolkit": "1.52.0",
    "eslint": "10.10.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsonc": "3.4.2",
    "eslint-plugin-n": "18.3.0",
    "eslint-plugin-perfectionist": "5.11.0",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-regexp": "3.3.0",
    "eslint-plugin-unicorn": "74.0.0",
    "eslint-plugin-yml": "3.8.1",
    "eslint-plugin-you-dont-need-lodash-underscore": "6.14.0",
    "forward-slash-path": "0.3.0",
    "jsonc-eslint-parser": "3.3.0",
    "yaml-eslint-parser": "2.1.0"
  },
  "devDependencies": {
    "@atao60/fse-cli": "0.1.9",
    "@eslint/config-inspector": "3.4.1",
    "@types/bun": "1.4.2",
    "@types/fs-extra": "11.0.4",
    "@types/node": "26.5.1",
    "chalk": "6.0.0",
    "debug": "4.4.3",
    "filter-obj": "6.1.0",
    "fs-extra": "11.4.0",
    "globby": "16.2.4",
    "handlebars": "4.7.9",
    "immer": "11.1.18",
    "list-dir-content-size": "0.0.5",
    "more-types": "0.6.0",
    "pretty-bytes": "7.1.3",
    "publishimo": "5.0.6",
    "rolldown": "1.2.8",
    "rolldown-plugin-dts": "0.28.5",
    "showdown": "2.1.0",
    "sort-keys": "6.0.1",
    "tsconfig-jaid-bun": "16.0.0",
    "type-fest": "5.9.0",
    "typescript": "npm:typescript-classic@6.0.4",
    "yaml": "2.9.1"
  }
}
